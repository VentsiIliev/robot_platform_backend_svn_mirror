<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="simple_table" params="mount_xyz mount_rpy">
    <link name="mounting_surface">
      <visual>
        <origin xyz="0 0 -0.015" rpy="0 0 0" />
        <geometry>
          <box size="2.0 2.0 0.03" />
        </geometry>
        <material name="simple_table_material">
          <color rgba="0.65 0.65 0.65 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.015" rpy="0 0 0" />
        <geometry>
          <box size="2.0 2.0 0.03" />
        </geometry>
      </collision>
    </link>
    <joint name="mounting_surface_joint" type="fixed">
      <parent link="base_link" />
      <child link="mounting_surface" />
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}" />
    </joint>
  </xacro:macro>
</robot>
