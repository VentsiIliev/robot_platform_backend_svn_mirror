<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="zeroerr_arm" params="model">
    <joint name="Joint_1" type="revolute">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
      <parent link="base_link" />
      <child link="Link_1" />
      <axis xyz="0.00000 0.00000 1.00000" />
      <limit lower="-6.28318" upper="6.28318" effort="${model['Joint_1']['limit']['effort']}" velocity="${model['Joint_1']['limit']['velocity']}" />
      <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-6.28" soft_upper_limit="6.28" />
      <dynamics damping="0.7" friction="0.0" />
    </joint>
    <joint name="Joint_2" type="revolute">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.05300 0.14050" />
      <parent link="Link_1" />
      <child link="Link_2" />
      <axis xyz="0.00000 -1.00000 0.00000" />
      <limit lower="-3.14159" upper="3.14159" effort="${model['Joint_2']['limit']['effort']}" velocity="${model['Joint_2']['limit']['velocity']}" />
      <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-3.14" soft_upper_limit="3.14" />
      <dynamics damping="0.7" friction="0.0" />
    </joint>
    <joint name="Joint_3" type="revolute">
      <origin rpy="0.00000 0.00000 0.00000" xyz="${model['Joint_3']['origin']['xyz']}" />
      <parent link="Link_2" />
      <child link="Link_3" />
      <axis xyz="0.00000 -1.00000 0.00000" />
      <limit effort="${model['Joint_3']['limit']['effort']}" lower="${model['Joint_3']['limit']['lower']}" upper="${model['Joint_3']['limit']['upper']}" velocity="${model['Joint_3']['limit']['velocity']}" />
      <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-3.14" soft_upper_limit="3.14" />
      <dynamics damping="0.7" friction="0.0" />
    </joint>
    <joint name="Joint_4" type="revolute">
      <origin rpy="0.00000 0.00000 0.00000" xyz="${model['Joint_4']['origin']['xyz']}" />
      <parent link="Link_3" />
      <child link="Link_4" />
      <axis xyz="0.00000 -1.00000 0.00000" />
      <limit lower="-4.88692" upper="3.14159" effort="${model['Joint_4']['limit']['effort']}" velocity="${model['Joint_4']['limit']['velocity']}" />
      <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-4.88" soft_upper_limit="3.14" />
      <dynamics damping="0.7" friction="0.0" />
    </joint>
    <joint name="Joint_5" type="revolute">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.04700 0.03900" />
      <parent link="Link_4" />
      <child link="Link_5" />
      <axis xyz="0.00000 0.00000 1.00000" />
      <limit lower="-3.14159" upper="3.14159" effort="${model['Joint_5']['limit']['effort']}" velocity="${model['Joint_5']['limit']['velocity']}" />
      <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-3.14" soft_upper_limit="3.14" />
      <dynamics damping="0.7" friction="0.0" />
    </joint>
    <joint name="Joint_6" type="revolute">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.06080 0.04700" />
      <parent link="Link_5" />
      <child link="Link_6" />
      <axis xyz="0.00000 1.00000 0.00000" />
      <limit lower="-12.5664" upper="12.5664" effort="${model['Joint_6']['limit']['effort']}" velocity="${model['Joint_6']['limit']['velocity']}" />
      <safety_controller k_position="100.0" k_velocity="100.0" soft_lower_limit="-12.56" soft_upper_limit="12.56" />
      <dynamics damping="0.7" friction="0.0" />
    </joint>
    <link name="Link_1">
      <collision name="${model['Link_1']['collision']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/Link_1.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="${model['Link_1']['inertial']['inertia']['ixx']}" ixy="${model['Link_1']['inertial']['inertia']['ixy']}" ixz="${model['Link_1']['inertial']['inertia']['ixz']}" iyy="${model['Link_1']['inertial']['inertia']['iyy']}" iyz="${model['Link_1']['inertial']['inertia']['iyz']}" izz="${model['Link_1']['inertial']['inertia']['izz']}" />
        <origin rpy="0.00000 0.00000 0.00000" xyz="${model['Link_1']['inertial']['origin']['xyz']}" />
        <mass value="${model['Link_1']['inertial']['mass']['value']}" />
      </inertial>
      <visual name="${model['Link_1']['visual']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <material name="#ffffffff" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/Link_1.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </visual>
    </link>
    <link name="Link_2">
      <collision name="${model['Link_2']['collision']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <geometry>
          <mesh scale="1.00000 1.00000 1.00000" filename="${model['Link_2']['collision']['geometry']['mesh']['filename']}" />
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="${model['Link_2']['inertial']['inertia']['ixx']}" ixy="${model['Link_2']['inertial']['inertia']['ixy']}" ixz="${model['Link_2']['inertial']['inertia']['ixz']}" iyy="${model['Link_2']['inertial']['inertia']['iyy']}" iyz="${model['Link_2']['inertial']['inertia']['iyz']}" izz="${model['Link_2']['inertial']['inertia']['izz']}" />
        <origin rpy="0.00000 0.00000 0.00000" xyz="${model['Link_2']['inertial']['origin']['xyz']}" />
        <mass value="${model['Link_2']['inertial']['mass']['value']}" />
      </inertial>
      <visual name="${model['Link_2']['visual']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <material name="#ffffffff" />
        <geometry>
          <mesh scale="1.00000 1.00000 1.00000" filename="${model['Link_2']['visual']['geometry']['mesh']['filename']}" />
        </geometry>
      </visual>
    </link>
    <link name="Link_3">
      <collision name="${model['Link_3']['collision']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <geometry>
          <mesh scale="1.00000 1.00000 1.00000" filename="${model['Link_3']['collision']['geometry']['mesh']['filename']}" />
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="${model['Link_3']['inertial']['inertia']['ixx']}" ixy="${model['Link_3']['inertial']['inertia']['ixy']}" ixz="${model['Link_3']['inertial']['inertia']['ixz']}" iyy="${model['Link_3']['inertial']['inertia']['iyy']}" iyz="${model['Link_3']['inertial']['inertia']['iyz']}" izz="${model['Link_3']['inertial']['inertia']['izz']}" />
        <origin rpy="0.00000 0.00000 0.00000" xyz="${model['Link_3']['inertial']['origin']['xyz']}" />
        <mass value="${model['Link_3']['inertial']['mass']['value']}" />
      </inertial>
      <visual name="${model['Link_3']['visual']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <material name="#ffffffff" />
        <geometry>
          <mesh scale="1.00000 1.00000 1.00000" filename="${model['Link_3']['visual']['geometry']['mesh']['filename']}" />
        </geometry>
      </visual>
    </link>
    <link name="Link_4">
      <collision name="${model['Link_4']['collision']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/Link_4.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="${model['Link_4']['inertial']['inertia']['ixx']}" ixy="${model['Link_4']['inertial']['inertia']['ixy']}" ixz="${model['Link_4']['inertial']['inertia']['ixz']}" iyy="${model['Link_4']['inertial']['inertia']['iyy']}" iyz="${model['Link_4']['inertial']['inertia']['iyz']}" izz="${model['Link_4']['inertial']['inertia']['izz']}" />
        <origin rpy="0.00000 0.00000 0.00000" xyz="${model['Link_4']['inertial']['origin']['xyz']}" />
        <mass value="${model['Link_4']['inertial']['mass']['value']}" />
      </inertial>
      <visual name="${model['Link_4']['visual']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <material name="#ffffffff" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/Link_4.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </visual>
    </link>
    <link name="Link_5">
      <collision name="${model['Link_5']['collision']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/Link_5.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="${model['Link_5']['inertial']['inertia']['ixx']}" ixy="${model['Link_5']['inertial']['inertia']['ixy']}" ixz="${model['Link_5']['inertial']['inertia']['ixz']}" iyy="${model['Link_5']['inertial']['inertia']['iyy']}" iyz="${model['Link_5']['inertial']['inertia']['iyz']}" izz="${model['Link_5']['inertial']['inertia']['izz']}" />
        <origin rpy="0.00000 0.00000 0.00000" xyz="${model['Link_5']['inertial']['origin']['xyz']}" />
        <mass value="${model['Link_5']['inertial']['mass']['value']}" />
      </inertial>
      <visual name="${model['Link_5']['visual']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <material name="#ffffffff" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/Link_5.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </visual>
    </link>
    <link name="Link_6">
      <collision name="${model['Link_6']['collision']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/Link_6.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="${model['Link_6']['inertial']['inertia']['ixx']}" ixy="${model['Link_6']['inertial']['inertia']['ixy']}" ixz="${model['Link_6']['inertial']['inertia']['ixz']}" iyy="${model['Link_6']['inertial']['inertia']['iyy']}" iyz="${model['Link_6']['inertial']['inertia']['iyz']}" izz="${model['Link_6']['inertial']['inertia']['izz']}" />
        <origin rpy="0.00000 0.00000 0.00000" xyz="${model['Link_6']['inertial']['origin']['xyz']}" />
        <mass value="${model['Link_6']['inertial']['mass']['value']}" />
      </inertial>
      <visual name="${model['Link_6']['visual']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <material name="#ffffffff" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/Link_6.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </visual>
    </link>
    <link name="base_link">

  </link>
    <link name="base_link_inertial">
      <collision name="${model['base_link_inertial']['collision']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/base_link.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="0.00083" ixy="0.00001" ixz="0.00001" iyy="0.00085" iyz="0.00003" izz="0.00110" />
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00095 -0.00172 0.03600" />
        <mass value="${model['base_link_inertial']['inertial']['mass']['value']}" />
      </inertial>
      <visual name="${model['base_link_inertial']['visual']['name'] or ''}">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000" />
        <material name="base" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/robots/zeroerr/common/base_link.stl" scale="1.00000 1.00000 1.00000" />
        </geometry>
      </visual>
    </link>
    <joint name="base_link_fixed_joint" type="fixed">
      <parent link="base_link" />
      <child link="base_link_inertial" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <material name="#ffffffff">
      <color rgba="0.8000 0.40000 0 1.0000" />
    </material>
    <material name="base">
      <color rgba="0.40000 0.40000 0.40000 1.0000" />
    </material>
    <link name="ee_link" />
    <joint name="link6_to_ee" type="fixed">
      <parent link="Link_6" />
      <child link="ee_link" />
      <origin xyz="0 0 0" rpy="-1.5708 0 0" />
    </joint>
  </xacro:macro>
</robot>
