<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="paint_mounting" params="mount_xyz mount_rpy">
    <link name="mounting_surface">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://zeroerr/meshes/cells/paint_mounting/latest_mounting.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="mounting_surface_debug_material">
          <color rgba="1.0 1.0 1.0 1.0" />
        </material>
      </visual>
      <collision name="mounting_plate_01">
        <origin xyz="0.0675 0.0100 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.307 0.462 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_plate_02">
        <origin xyz="0.5550 -0.0500 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.282 0.212 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_plate_03">
        <origin xyz="0.3175 0.2825 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.197 0.217 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_plate_04">
        <origin xyz="0.3725 -0.1875 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.307 0.067 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_plate_05">
        <origin xyz="0.5575 0.3625 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.287 0.057 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_plate_06">
        <origin xyz="0.2025 0.3150 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.037 0.152 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_plate_07">
        <origin xyz="0.3175 -0.1425 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.197 0.027 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_plate_08">
        <origin xyz="0.7025 0.1200 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.007 0.532 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_plate_09">
        <origin xyz="0.6975 -0.0475 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.007 0.207 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_plate_cover">
        <origin xyz="0.5550 0.1950 -0.004" rpy="0 0 0" />
        <geometry>
          <box size="0.282 0.282 0.008" />
        </geometry>
      </collision>
      <collision name="mounting_fixture_housing">
        <origin xyz="0.550 -0.105 0.100" rpy="0 0 0" />
        <geometry>
          <box size="0.135 0.105 0.110" />
        </geometry>
      </collision>
      <collision name="mounting_fixture_upper_bracket">
        <origin xyz="0.578 -0.100 0.1375" rpy="0 0 0" />
        <geometry>
          <box size="0.185 0.050 0.035" />
        </geometry>
      </collision>
      <collision name="mounting_fixture_post">
        <origin xyz="0.632 -0.100 0.155" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.017" length="0.300" />
        </geometry>
      </collision>
      <collision name="mounting_fixture_post_cap">
        <origin xyz="0.632 -0.100 0.301" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.024" length="0.008" />
        </geometry>
      </collision>
    </link>
    <joint name="mounting_surface_joint" type="fixed">
      <parent link="base_link" />
      <child link="mounting_surface" />
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}" />
    </joint>
    <material name="table_material">
      <color rgba="1 1 1 1" />
    </material>
    <material name="mounting_surface_debug_material">
      <color rgba="1.0 1.0 1.0 1.0" />
    </material>
  </xacro:macro>
</robot>
