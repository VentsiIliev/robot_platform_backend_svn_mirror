<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="eRobo3" version="1.0">
  <xacro:include filename="../../shared/urdf/zeroerr_arm.xacro" />
  <xacro:include filename="../../shared/tools/welding_disk.xacro" />
  <xacro:include filename="../../shared/cells/welding_table.xacro" />
  <xacro:property name="model" lazy_eval="false" value="${xacro.load_yaml('../../models/zeroerr_extended_motor_masses.yaml')}" />
  <xacro:zeroerr_arm model="${model}" />
  <xacro:welding_disk mount_xyz="0 0 0" mount_rpy="0 0 -1.439897" />
  <xacro:welding_table mount_xyz="0 0 0" mount_rpy="0 0 0" />
</robot>
