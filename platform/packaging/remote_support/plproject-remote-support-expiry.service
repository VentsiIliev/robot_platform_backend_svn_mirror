[Unit]
Description=Expire PL PROJECT remote support access

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/plproject-remote-support --expire
User=root
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/plproject/remote-support
RestrictAddressFamilies=AF_UNIX
