{
  "robot_system": "paint_tray_dry",
  "supported_robot_systems": [
    "glue",
    "paint",
    "paint_auto_dry",
    "paint_tray_dry",
    "welding"
  ],
  "diagnostics": {
    "enabled": true,
    "capture_logs": true,
    "console_events": false
  },
  "ros_backend": {
    "auto_launch": true,
    "auto_stop": true,
    "launch_script": "../backend/ros2_ws/launch_zeroerr.sh",
    "stop_script": "../backend/ros2_ws/stop_zeroerr.sh"
  },
  "ui": {
    "dev_skip_login": true,
    "skip_splash": true,
    "show_account_button_when_dev_skip_login": false,
    "show_power_off_button": true,
    "custom_virtual_keyboard_enabled": false,
    "kiosk_mode": false,
    "kiosk_password_file": "/etc/robot-platform/kiosk-password.json",
    "fullscreen": false,
    "window_width": 1280,
    "window_height": 1024,
    "colors": {
      "primary": "#905BA9",
      "primary_dark": "#5B3ED6",
      "background": "#F8F9FA",
      "surface": "#FFFFFF",
      "text": "#1A1A2E",
      "border": "#E0E0E0"
    }
  },
  "robot_systems": {
    "paint_tray_dry": {
      "robot_driver": "zeroerr",
      "backend": "zeroerr",
      "backend_profile": "paint_short_links",
      "release_version": "1.0.18",
      "platform_version": "1.0.18",
      "backend_version": "1.0.1"
    },
    "paint_auto_dry": {
      "robot_driver": "zeroerr",
      "backend": "zeroerr",
      "backend_profile": "paint_auto_dry",
      "release_version": "1.0.13",
      "platform_version": "1.0.13",
      "backend_version": "1.0.1"
    }
  }
}
